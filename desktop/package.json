{
  "name": "qbao-desktop",
  "version": "3.27.2",
  "description": "Qbao 全能互动做题引擎 — Windows 桌面客户端",
  "main": "main.js",
  "author": "Paraso42",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.paraso42.qbao",
    "productName": "Qbao",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "config.json",
      "!config.local.json",
      { "from": "../app/dist", "to": "app" }
    ],
    "publish": [
      { "provider": "github", "owner": "Paraso42", "repo": "Qbao", "releaseType": "release" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "signAndEditExecutable": false,
      "artifactName": "Qbao-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Qbao"
    }
  }
}
