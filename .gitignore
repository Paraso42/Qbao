# ================= Qbao .gitignore =================
# 策略：GitHub 只管理 app/（前端）、server/（后端）、docs/、tools/ 四部分；
# 一切隐私/本地内容统一放 local/（密钥、用户数据、日志、历史快照）。

# ---- Node 依赖 ----
node_modules/
server/node_modules/

# ---- 环境变量与密钥（任何位置都不上传）----
.env
.env.*
!.env.example
*.pem
*.key
*.lnk
*.bundle

# ---- 本地专用目录：隐私数据/密钥/日志/版本快照，永不上传 GitHub ----
local/

# ---- 运行时上传文件（含用户数据，生产环境实时生成）----
uploads/
server/uploads/

# ---- 日志 ----
*.log

# ---- 系统文件 ----
.DS_Store
Thumbs.db

# ---- tools/：默认忽略其中的一次性脚本，仅保留说明 ----
tools/*
!tools/README.md

# ---- 桌面端（Electron）----
desktop/node_modules/
desktop/release/
desktop/config.local.json
desktop/dist/
